{
  "name": "raees-atelier-concept",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.mjs",
    "qa:prepare": "node scripts/qa-prepare.mjs",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "review:package": "node scripts/package-review.mjs"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.9"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.9",
    "prettier": "^3.9.7",
    "wrangler": "^4.33.0"
  }
}
